{
  "name": "@local/kb-panel",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Knowledge base page and in-vault memory chip, session-scoped core-memory prompt injection, and the schema §5 pipeline trigger (step 1 transcript append + step 2 extraction schedule).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./ingest": "./ingest.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "ingest.js",
    "judge.js",
    "work-brief.js",
    "http-guard.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
