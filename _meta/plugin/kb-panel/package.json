{
  "name": "dsh-kb-panel",
  "version": "3.3.4",
  "description": "Governed long-term memory for dsh: an append-only raw layer, confirmed-only injection, isolated project stores, and a local memory page.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shehuilaoliumang/dsh-memory.git",
    "directory": "_meta/plugin/kb-panel"
  },
  "homepage": "https://github.com/shehuilaoliumang/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/shehuilaoliumang/dsh-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./ingest": "./ingest.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "ingest.js",
    "judge.js",
    "http-guard.js",
    "inject-ranking.mjs",
    "rank-experiment.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
